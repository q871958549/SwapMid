# SwapMid Docker Compose Environment Configuration
# Copy this file to .env and replace placeholder secrets before production deployment.

IMAGE_TAG=1.0.1-local
RELEASE_SHA=local

# Host Port Bindings (defaults chosen to avoid common local port collisions)
WEB_PORT=13000
API_PORT=18080
POSTGRES_PORT=15432
REDIS_PORT=16379
RABBITMQ_AMQP_PORT=15672
RABBITMQ_MGMT_PORT=25672
SEQ_PORT=15341

# Public Origins
PUBLIC_WEB_URL=http://localhost:13000
PUBLIC_API_URL=http://localhost:18080
REQUIRE_HTTPS_METADATA=false
# Set to true when serving behind HTTPS in production
COOKIE_SECURE=false

# Infrastructure Credentials
POSTGRES_DB=swapmid
POSTGRES_USER=swapmid
POSTGRES_PASSWORD=SwapMid_ChangeMe_Postgres!2026

RABBITMQ_USER=swapmid
RABBITMQ_PASSWORD=SwapMid_ChangeMe_RabbitMQ!2026

# OpenIddict Signing Certificate & ABP String Encryption Passphrases
# Replace both with unique strong secrets before production deployment.
OPENIDDICT_PFX_PASS=SwapMid_ChangeMe_Pfx!2026
STRING_ENCRYPTION_PASSPHRASE=SwapMid_ChangeMe_Enc!2026

# Optional base64-encoded 32-byte key for Next.js Server Actions across rebuilds
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Managed API Gateway (fail-closed by default; set true + explicit upstream host allowlist when needed)
API_GATEWAY_ENABLED=false
API_GATEWAY_ALLOWED_HOSTS=
API_GATEWAY_ALLOWED_PRIVATE_NETWORKS=

# Controlled Read-Only / Draft-Only MCP Server (/api/mcp; fail-closed by default)
MCP_ENABLED=false

# Optional External OIDC Federation (disabled by default; ClientSecret stays server-side in .NET)
EXTERNAL_OIDC_ENABLED=false
EXTERNAL_OIDC_DISPLAY_NAME=Enterprise SSO
EXTERNAL_OIDC_AUTHORITY=
EXTERNAL_OIDC_AUTHORIZATION_ENDPOINT=
EXTERNAL_OIDC_CLIENT_ID=
EXTERNAL_OIDC_CLIENT_SECRET=
EXTERNAL_OIDC_REQUIRE_HTTPS=true
