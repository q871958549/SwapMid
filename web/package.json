{
  "name": "swapmid-web",
  "version": "2.8.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "next dev --port 5175",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "pnpm lint:code && pnpm check:i18n",
    "lint:code": "eslint --max-warnings=0",
    "check:ui": "node --test scripts/ui-health.test.mjs scripts/new-page.test.mjs && node scripts/ui-health.mjs",
    "ui:baseline": "node scripts/ui-health.mjs --write-baseline",
    "new:page": "node scripts/new-page.mjs",
    "check:i18n": "pnpm check:i18n:input && pnpm check:i18n:generated",
    "check:i18n:input": "node --test scripts/i18n-audit-registry.test.mjs scripts/i18n-trusted-pr-input.test.mjs scripts/i18n-static-references.test.mjs scripts/i18n-message-contracts.test.mjs scripts/i18n-generation-core.test.mjs scripts/i18n-english-translator.test.mjs scripts/i18n-safe-files.test.mjs scripts/i18n-pr-input-boundary.test.mjs scripts/scan-hardcoded-cn.test.mjs scripts/check-backend-i18n.test.mjs scripts/check-terminology.test.mjs && node scripts/check-i18n-keys.mjs --validate-audit-input && node scripts/sync-i18n.mjs --validate-input && node scripts/sync-backend-i18n.mjs --validate-input && node scripts/scan-hardcoded-cn.mjs --check && node scripts/check-backend-i18n.mjs --validate-input && node scripts/check-terminology.mjs",
    "check:i18n:generated": "node scripts/check-i18n-keys.mjs && node scripts/sync-i18n.mjs --check && node scripts/sync-backend-i18n.mjs --check && node scripts/check-backend-i18n.mjs",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "i18n:bootstrap": "node scripts/sync-i18n.mjs --bootstrap",
    "i18n:check-generated": "node scripts/sync-i18n.mjs --check",
    "i18n:prune": "node scripts/check-i18n-keys.mjs --prune",
    "i18n:baseline": "node scripts/scan-hardcoded-cn.mjs --write-baseline",
    "i18n:maintain": "node scripts/scan-hardcoded-cn.mjs --check && node scripts/check-backend-i18n.mjs --user-friendly-only && pnpm i18n:prune && pnpm i18n:sync && pnpm i18n:backend-sync && pnpm i18n:baseline && pnpm i18n:backend-baseline",
    "i18n:backend-sync": "node scripts/sync-backend-i18n.mjs",
    "i18n:backend-bootstrap": "node scripts/sync-backend-i18n.mjs --bootstrap",
    "i18n:backend-check": "node scripts/sync-backend-i18n.mjs --check",
    "i18n:backend-baseline": "node scripts/check-backend-i18n.mjs --write-baseline",
    "gen:zh-hant": "node scripts/gen-zh-hant.mjs",
    "check:deps": "knip && depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "test:security-deps": "node --test scripts/security-dependency-contract.test.mjs",
    "check:unused": "knip --reporter compact --no-exit-code",
    "test": "vitest",
    "test:run": "vitest run",
    "test:session-redis": "node scripts/session-refresh-redis.integration.mjs && node scripts/session-refresh-cleanup.integration.mjs",
    "gen:api": "openapi-ts && node scripts/format-generated-index.mjs",
    "gen:api-doc": "node --test scripts/api-doc-field-policy.test.mjs && node scripts/gen-api-doc.mjs",
    "export:api": "node scripts/export-openapi.mjs",
    "docs:api": "pnpm --package=@redocly/cli@latest dlx redocly build-docs ../docs/api/openapi.generated.json -o ../docs/api/openapi.html",
    "sync:api": "node scripts/sync-api.mjs",
    "sync:api:fast": "node scripts/sync-api.mjs --in-memory --skip-portal",
    "verify:api": "node scripts/sync-api.mjs --verify",
    "verify:api:fast": "node scripts/sync-api.mjs --in-memory --verify",
    "verify:api:clean": "pnpm gen:api && pnpm gen:api-doc && node scripts/verify-api-clean.mjs",
    "check:api-summary": "node --test scripts/check-api-summary.test.mjs && node scripts/check-api-summary.mjs",
    "api-summary:baseline": "node scripts/check-api-summary.mjs --write-baseline"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-context-menu": "^2.3.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.23.0",
    "next": "16.4.6",
    "next-intl": "^4.13.2",
    "pinyin-pro": "^3.28.1",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "dependency-cruiser": "18.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "knip": "6.27.0",
    "opencc-js": "^1.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "undici": "^8.12.2",
    "vitest": "~4.1.12"
  }
}
